<Page x:Class="KeocGrabber.Page_Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KeocGrabber"
      xmlns:uc="clr-namespace:FalconWpf"
      mc:Ignorable="d" 
      d:DesignHeight="604" d:DesignWidth="1260"
      Title="Page_Main">

    <Page.DataContext>
        <local:Page_MainDataContext x:Name="datacontext"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <UniformGrid x:Name="CamGrid" Columns="2" Rows="2">
            <GroupBox x:Name="Cam1Viewer">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FRONT (CAM1)" Margin="3,0"/>
                        <uc:UserButton Content="View" CornerRadius="3" Click="bn_Cam1ViewImage_Click"/>
                        <uc:UserButton Content="Clear" CornerRadius="3"  Click="bn_Cam1ViewClear_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <uc:ImageViewer x:Name="imgview1"/>
            </GroupBox>
            <GroupBox x:Name="Cam2Viewer">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="REAR (CAM2)" Margin="3,0"/>
                        <uc:UserButton Content="View" CornerRadius="3" Click="bn_Cam2ViewImage_Click"/>
                        <uc:UserButton Content="Clear" CornerRadius="3" Click="bn_Cam2ViewClear_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <uc:ImageViewer x:Name="imgview2"/>
            </GroupBox>
            <GroupBox x:Name="Cam3Viewer">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IN SIDE (CAM3)" Margin="3,0"/>
                        <uc:UserButton Content="View" CornerRadius="3" Click="bn_Cam3ViewImage_Click"/>
                        <uc:UserButton Content="Clear" CornerRadius="3" Click="bn_Cam3ViewClear_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <uc:ImageViewer x:Name="imgview3"/>
            </GroupBox>
            <GroupBox x:Name="Cam4Viewer">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OUT SIDE (CAM4)" Margin="3,0"/>
                        <uc:UserButton Content="View" CornerRadius="3" Click="bn_Cam4ViewImage_Click"/>
                        <uc:UserButton Content="Clear" CornerRadius="3" Click="bn_Cam4ViewClear_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <uc:ImageViewer x:Name="imgview4"/>
            </GroupBox>
        </UniformGrid>
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding TestBtnHeight}"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <UniformGrid Rows="1">
                    <uc:UserButton Content="Manual Grab Start" Click="bn_ManualGrab_Click" CornerRadius="3" Margin="3" IsEnabled="{Binding IsGrabStop}"/>
                    <uc:UserButton Content="Test" Click="bn_Test_Click" CornerRadius="3" Margin="3"/>
                </UniformGrid>
                <!--
                <UniformGrid Rows="1">
                    <uc:UserButton Content="Test Grab" Click="bn_testgrab_click"/>
                    <uc:UserButton Content="Test Grab Stop" Click="bn_testgrabstop_click"/>
                    <uc:UserButton Content="Test Save" Click="bn_testsave_click"/>
                </UniformGrid>
                -->
            </Grid>
            <Grid Grid.Row="1">
                <Frame Grid.Row="1" NavigationUIVisibility="Hidden" Content="{Binding PageProcess}"/>
            </Grid>
            <Grid Grid.Row="2">
                <GroupBox Header="CellID">
                    <TextBlock Text="{Binding CellID}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="3">
                <GroupBox Header="GrabState">
                    <UniformGrid Rows="1">
                        <GroupBox x:Name="GrabCam1" Header="FRONT" TextBlock.FontSize="8" MouseDoubleClick="GrabState1_MouseDoubleClick">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cam1Grab}" Value="Wait">
                                                <Setter Property="Background" Value="{StaticResource NGBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cam1Grab}" Value="Compl">
                                                <Setter Property="Background" Value="{StaticResource OKBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Cam1Grab}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </GroupBox>
                        <GroupBox x:Name="GrabCam2" Header="REAR" TextBlock.FontSize="8" MouseDoubleClick="GrabState2_MouseDoubleClick">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cam2Grab}" Value="Wait">
                                                <Setter Property="Background" Value="{StaticResource NGBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cam2Grab}" Value="Compl">
                                                <Setter Property="Background" Value="{StaticResource OKBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Cam2Grab}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </GroupBox>
                        <GroupBox x:Name="GrabCam3" Header="IN SIDE" TextBlock.FontSize="8" MouseDoubleClick="GrabState3_MouseDoubleClick">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cam3Grab}" Value="Wait">
                                                <Setter Property="Background" Value="{StaticResource NGBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cam3Grab}" Value="Compl">
                                                <Setter Property="Background" Value="{StaticResource OKBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Cam3Grab}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </GroupBox>
                        <GroupBox x:Name="GrabCam4" Header="OUT SIDE" TextBlock.FontSize="8" MouseDoubleClick="GrabState4_MouseDoubleClick">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cam4Grab}" Value="Wait">
                                                <Setter Property="Background" Value="{StaticResource NGBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cam4Grab}" Value="Compl">
                                                <Setter Property="Background" Value="{StaticResource OKBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Cam4Grab}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </GroupBox>
                    </UniformGrid>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="4">
                <!-- 센서 입력 표시(한 줄). 램프 = 신호 검출(상승 에지 후 SensorLampHold 동안 유지),
                     옆 숫자 = 누적 횟수. 마지막 검출 시각/펄스 폭은 마우스를 올리면 표시된다.
                     Operator 외 권한에서 더블클릭하면 카운트 초기화. -->
                <Border Background="Transparent" MouseLeftButtonDown="SensorIO_MouseDown"
                        ToolTip="센서 입력 (15Pin D-Sub #3(+) / #12(-))">
                    <DockPanel LastChildFill="False" Margin="5,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SensorTitle}" FontSize="10"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="IOCam1" Orientation="Horizontal" Margin="6,0,0,0" ToolTip="{Binding Sensor1Detail}">
                                <Ellipse Width="9" Height="9" Stroke="Gray" StrokeThickness="0.5" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="Gainsboro"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sensor1On}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OKBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Sensor1Info}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="IOCam2" Orientation="Horizontal" Margin="8,0,0,0" ToolTip="{Binding Sensor2Detail}">
                                <Ellipse Width="9" Height="9" Stroke="Gray" StrokeThickness="0.5" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="Gainsboro"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sensor2On}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OKBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Sensor2Info}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="IOCam3" Orientation="Horizontal" Margin="8,0,0,0" ToolTip="{Binding Sensor3Detail}">
                                <Ellipse Width="9" Height="9" Stroke="Gray" StrokeThickness="0.5" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="Gainsboro"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sensor3On}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OKBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Sensor3Info}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="IOCam4" Orientation="Horizontal" Margin="8,0,0,0" ToolTip="{Binding Sensor4Detail}">
                                <Ellipse Width="9" Height="9" Stroke="Gray" StrokeThickness="0.5" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="Gainsboro"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sensor4On}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OKBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Sensor4Info}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="5">
                <GroupBox Header="Log">
                    <ListBox Name="listLog"/>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
