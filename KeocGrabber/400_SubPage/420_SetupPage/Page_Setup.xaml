                                                <DataGridTextColumn Header="Y"      Binding="{Binding Y}"      Width="1*"/>
                                                <DataGridTextColumn Header="Width"  Binding="{Binding Width}"  Width="1*"/>
                                                <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="1*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>-->
                        </TabControl>
                        <GroupBox Grid.Row="2">
                            <GroupBox.Header>
                                <WrapPanel>
                                    <TextBlock Text="Light Setting" VerticalAlignment="Center"/>
                                    <uc:UserButton Content="Light On All" CornerRadius="3" Margin="5,0,0,0" Padding="3,0" Click="bn_LightOn_Click" IsEnabled="{Binding IsLightEnabled}"/>
                                    <uc:UserButton Content="Light Off All" CornerRadius="3" Margin="5,0,0,0" Padding="3,0" Click="bn_LightOff_Click" IsEnabled="{Binding IsLightDisabled}"/>
                                </WrapPanel>
                            </GroupBox.Header>
                            <UniformGrid Columns="2">
                                <GroupBox Header="TOP LIGHTS" x:Name="SetTopLight">
                                    <UniformGrid Columns="1">
                                        <uc:UserButton Content="Light On" Margin="20" CornerRadius="3" Click="bn_LightOnTopAll_Click"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <uc:UserCombo UCBTitle="SELECT LC" UCBItemSource="{Binding TopLightItems}" UCBSelectedIndex="{Binding LightTopCtrlNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UCBUnitWidth="0"/>
                                            <uc:UserButton Grid.Column="1" Content="{Binding TopLightString}" Height="25" CornerRadius="3" Click="bn_LightOnTop_Click"/>
                                        </Grid>
                                        <uc:UserSlider USTitle="Light Value" USValue="{Binding LightTopValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" USMinimum="0" USMaximum="3500" USTickFrequency="25" USValueWidth="40" USTitleWidth="100"/>
                                    </UniformGrid>
                                </GroupBox>
                                <GroupBox Header="BOT LIGHTS" x:Name="SetBotLight">
                                    <UniformGrid Columns="1">
                                        <uc:UserButton Content="Light On" Margin="20" CornerRadius="3" Click="bn_LightOnBotAll_Click"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <uc:UserCombo UCBTitle="Ch No." UCBItemSource="{StaticResource CBItemsLightChannel}" UCBSelectedIndex="{Binding LightBotChNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UCBUnitWidth="0"/>
                                            <uc:UserButton Grid.Column="1" Content="{Binding BotLightString}" Height="25" CornerRadius="3" Click="bn_LightOnBot_Click"/>
                                        </Grid>
                                        <uc:UserSlider Grid.Row="1" USTitle="Light Value" USValue="{Binding LightBotValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" USMinimum="0" USMaximum="255" USTickFrequency="25" USValueWidth="40" USTitleWidth="100"/>
                                    </UniformGrid>
                                </GroupBox>
                            </UniformGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>
        <Grid Grid.Column="2" IsEnabled="{Binding IsAdmin}">
            <WrapPanel>
                <uc:UserButton Content="Test Image" Click="bn_ImageTest_Click"      Width="{Binding Path=Width, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}"/>
                <GroupBox Header="GiGA Test" Width="120">
                    <UniformGrid Columns =" 1">
                        <uc:UserParam UPUnitWidth="0" UPTitle="MyNode"  UPValue="{Binding MyNodeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:UserParam UPUnitWidth="0" UPTitle="Target1"  UPValue="{Binding TargetNodeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:UserParam UPUnitWidth="0" UPTitle="Target2"  UPValue="{Binding TargetNodeNo2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:UserParam UPUnitWidth="0" UPTitle="MailBox" UPValue="{Binding MailBoxNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:UserButton Content="Link Test" Click="bn_LinkTest_Click"/>
                        <uc:UserButton Content="GigaSend" Click="bn_GigaSend_Click"/>
                        <uc:UserButton Content="TcpIPSend" Click="bn_TcpIPSend_Click"/>
                        <uc:UserButton Content="PushImage" Click="bn_PushImage_Click"/>
                    </UniformGrid>
                </GroupBox>
            </WrapPanel>
        </Grid>
    </Grid>
</Page>
