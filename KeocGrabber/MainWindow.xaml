<Window x:Class="KeocGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeocGrabber"
        xmlns:uc="clr-namespace:FalconWpf"
        mc:Ignorable="d"
        Title="KeocGrabber" Height="720" Width="1280" Closing="Window_Closing" MinWidth="1280" MinHeight="720"
        Loaded="Page_MainWindow_Loaded">
    
    <Window.DataContext>
        <local:MainWindowDataContext x:Name="datacontext"/>
    </Window.DataContext>
    
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="800"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrRecipe, StringFormat=Current Recipe : {0}}"/>
                    <TextBlock Grid.Column="1" FontSize="10" Text="{Binding CurrRecipeTime, StringFormat=LastWrite : {0:yyyy.MM.dd HH:mm:ss}}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <StackPanel.Resources>
                        <Style TargetType="uc:UserButton">
                            <Setter Property="Width" Value="150"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </StackPanel.Resources>
                    <uc:UserButton x:Name="bnMain" CornerRadius="3" Content="Main" Click="bn_Menu_Click" Tag="0"/>
                    <uc:UserButton x:Name="bnSetup" CornerRadius="3" Content="Setup" Click="bn_Menu_Click" Tag="1"/>
                    <UniformGrid Columns="1" VerticalAlignment="Center">
                        <CheckBox Content="Manual Recipe" IsChecked="{Binding IsManualRecipe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="CheckBox가 활성화 되어 있는 동안, JAVAS으로부터 Recipe 동기화 신호를 무시합니다.&#10;
CheckBox는 아래의 타이머가 만료 되면 자동 해제 됩니다.&#10;
시간을 연장하기 위해선 Setup 창의 Manual Time-Out의 시간을 늘리거나, 체크박스를 다시 활성화 해주세요.&#10;
-----------------------------------------------------------------------------------------------------------------&#10;
Trong khi CheckBox đang hoạt động, hãy bỏ qua tín hiệu đồng bộ hóa Recipe từ JAVAS.&#10;
CheckBox sẽ tự động tắt khi bộ hẹn giờ bên dưới hết hạn.&#10;
Để kéo dài thời gian, hãy tăng thời gian của Manual Time-Out trong cửa sổ Setup hoặc kích hoạt lại hộp kiểm."
                                  >
                            <CheckBox.Style>
                                <Style TargetType="{x:Type CheckBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualRecipe}" Value="True">
                                            <Setter Property="TextBlock.Foreground" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualRecipe}" Value="False">
                                            <Setter Property="TextBlock.Foreground" Value="Black"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualRecipe}" Value="True">
                                            <Setter Property="TextBlock.Foreground" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualRecipe}" Value="False">
                                            <Setter Property="TextBlock.Foreground" Value="Black"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SwitchTime, StringFormat=Time : {0:F2}/}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SwitchRecipeTimeOut, StringFormat={}{0} min}"/>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <UniformGrid Rows="1">
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageAuthority}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageCommunication}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageSystem}"/>
                </UniformGrid>
            </Grid>
        </Grid>
        <Grid>
            <Frame x:Name="frame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </DockPanel>
</Window>
